<nav>
  <h1>Quản lý sách</h1>
  <a href="/books/new">Thêm sách</a>
</nav>
<p>Danh sách được đọc bằng tài khoản MongoDB chỉ-đọc.</p>
<table>
  <thead><tr><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>Giá trước VAT</th><th>Giá sau VAT</th></tr></thead>
  <tbody>
    {{#each books}}
      <tr>
        <td>{{productCode}}</td><td>{{title}}</td><td>{{author}}</td>
        <td>{{price}}</td><td>{{priceAfterVat}}</td>
      </tr>
    {{else}}
      <tr><td colspan="5">Chưa có sách.</td></tr>
    {{/each}}
  </tbody>
</table>
