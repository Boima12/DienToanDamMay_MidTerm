<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quản lý sách</title>
    <style>
      body { font-family: Arial, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; color: #243047; }
      nav { display: flex; justify-content: space-between; margin-bottom: 2rem; }
      a, button { color: #fff; background: #2563eb; border: 0; border-radius: 4px; padding: .6rem 1rem; text-decoration: none; cursor: pointer; }
      table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      th, td { border-bottom: 1px solid #ddd; padding: .7rem; text-align: left; }
      form { display: grid; gap: .8rem; max-width: 480px; }
      input { padding: .6rem; border: 1px solid #bbb; border-radius: 4px; }
      footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; color: #536174; }
    </style>
  </head>
  <body>
    {{{body}}}
    <footer>Họ tên: Cao Hoàng Phước Bảo | MSSV: 23IT010 | VAT áp dụng: 5%</footer>
  </body>
</html>
